{
  "name": "career-form-mvp",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "npm run build:backend && npm run install:frontend && npm run build:frontend",
    "build:backend": "tsc",
    "install:frontend": "cd frontend && npm install",
    "build:frontend": "cd frontend && npm run build",
    "start": "npm run build:backend && npm run build:frontend && node dist/server.js",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx watch src/server.ts",
    "dev:frontend": "cd frontend && npm run dev"
  },
  "dependencies": {
    "@libsql/client": "^0.5.6",
    "express": "^4.18.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.19",
    "@types/uuid": "^9.0.8",
    "concurrently": "^8.2.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
